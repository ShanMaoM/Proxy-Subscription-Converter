# Web
# The Vite proxy provides same-origin API access; leave the base URL empty.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_PORT=5173

# Server
HOST=127.0.0.1
PORT=3000
# The server defaults to development; let Vite choose its build environment.
DATABASE_URL=./data/subscription-converter.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:5173
STATIC_ROOT=

# Direct server connections must not trust arbitrary forwarded headers.
# Set to 1 only behind a trusted proxy which replaces X-Forwarded-For.
TRUST_PROXY_HOPS=0
